# Copy this file to .env and fill in your values.
# MONGO_URI — MongoDB Atlas connection string. Use a database named
# "rewind" in the path (the part BEFORE .mongodb.net is the cluster name —
# never change that; only the database name after mongodb.net/ changes).
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/rewind?retryWrites=true&w=majority
# Any long random string.
JWT_SECRET=change-me-to-a-long-random-string
# Where the frontend runs (used for CORS).
CLIENT_URL=http://localhost:5173
# The family invite code: registration asks for this, so only the group
# can create accounts. REQUIRED in production — pick something only the
# family knows. (If left unset, registration is open — local dev only.)
FAMILY_CODE=our-secret-family-code
# PORT is set automatically by the host in production; leave unset locally.
